#usda 1.0
(
    defaultPrim = "Plug"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Plug" (
    customData = {
        dictionary latchbench = {
            string frame = "origin at plug tip centre, +X insertion, +Z latch side"
            double latch_k_theta_Nm_per_rad = 0.16770833333333338
            double latch_rest_deg = 9
        }
    }
)
{
    def Xform "body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.005
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.75, 0.82, 0.9)]
            double size = 1
            double3 xformOp:scale = (0.02248, 0.01168, 0.0066)
            double3 xformOp:translate = (-0.01124, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Xform "tip_frame"
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Xform "attach_frame"
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (-0.02248, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }
    }

    def Xform "latch" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 0.0003
        quatd xformOp:orient = (0.996917333733128, 0, 0.07845909572784494, 0)
        double3 xformOp:translate = (-0.001, 0, 0.0023)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            color3f[] primvars:displayColor = [(0.95, 0.55, 0.1)]
            double size = 1
            double3 xformOp:scale = (0.012, 0.0035, 0.001)
            double3 xformOp:translate = (-0.006, 0, 0.0005)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def PhysicsRevoluteJoint "latch_joint" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        customData = {
            dictionary latchbench = {
                double rest_deg_from_body_axis = 9
                string zero = "rest"
            }
        }
    )
    {
        float drive:angular:physics:damping = 5.1462064e-7
        float drive:angular:physics:stiffness = 0.0029270626
        float drive:angular:physics:targetPosition = 0
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "Y"
        rel physics:body0 = </Plug/body>
        rel physics:body1 = </Plug/latch>
        point3f physics:localPos0 = (-0.001, 0, 0.0023)
        point3f physics:localPos1 = (0, 0, 0)
        quatf physics:localRot0 = (0.9969173, 0, 0.0784591, 0)
        quatf physics:localRot1 = (1, 0, 0, 0)
        float physics:lowerLimit = -12
        float physics:upperLimit = 2
    }
}

