#usda 1.0
(
    defaultPrim = "Panel"
    metersPerUnit = 1
    upAxis = "Z"
)

def "Panel" (
    prepend references = @../medium/panel_3port_medium.usd@
)
{
    def Scope "Looks"
    {
        def Material "clear_pc"
        {
            token outputs:surface.connect = </Panel/Looks/clear_pc/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 1
                float inputs:clearcoatRoughness = 0.02
                color3f inputs:diffuseColor = (0.92, 0.94, 0.96)
                float inputs:ior = 1.58
                float inputs:metallic = 0
                float inputs:opacity = 0.18
                float inputs:roughness = 0.04
                token outputs:surface
            }
        }

